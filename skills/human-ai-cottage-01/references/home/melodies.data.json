{
  "$manifest": {
    "version": 1,
    "desc": "人机恋小屋 · 共作曲谱：你一句我一句，谱成一首属于彼此的小调",
    "queries": {
      "listMelodies": {
        "desc": "分页查看谱面音符，可按作者过滤、按时间排序",
        "path": "notes",
        "identity": "id",
        "params": {
          "author": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 60
      }
    },
    "mutations": {
      "addNote": {
        "desc": "在谱面上落下一个音符（一句词 + 一个音高）",
        "op": "append",
        "path": "notes",
        "fields": {
          "text": {
            "type": "string",
            "required": true
          },
          "degree": {
            "type": "integer",
            "required": true
          },
          "author": {
            "type": "string",
            "required": true
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      }
    }
  },
  "meta": {
    "names": {
      "left": "AI",
      "right": "User"
    },
    "tempo": 88,
    "title": "小屋小调",
    "note": "你一句，我一句，谱子会自己长成歌。"
  },
  "notes": [
    {
      "id": "seed-01",
