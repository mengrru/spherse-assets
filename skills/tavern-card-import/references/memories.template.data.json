{
  "$manifest": {
    "version": 1,
    "desc": "{角色名} 的长期记忆库：约定、偏好、事件与故事进展",
    "queries": {
      "listRecent": {
        "desc": "按时间倒序查看最近的记忆（默认 20 条，可分页）",
        "path": "memories",
        "identity": "id",
        "params": {
          "sort": { "type": "field", "default": "createdAt" },
          "dir": { "type": "enum", "values": ["asc", "desc"], "default": "desc" }
        },
        "defaultLimit": 20
      },
      "listByType": {
        "desc": "按记忆类型过滤查看（约定/偏好/事件/进展/其他）",
        "path": "memories",
        "identity": "id",
        "params": {
          "type": { "type": "enum", "values": ["约定", "偏好", "事件", "进展", "其他"], "required": true },
          "sort": { "type": "field", "default": "createdAt" },
          "dir": { "type": "enum", "values": ["asc", "desc"], "default": "desc" }
        },
        "defaultLimit": 20
      },
      "getMemory": {
        "desc": "根据 id 获取单条记忆",
        "path": "memories",
        "identity": "id",
        "defaultLimit": 1
      }
    },
    "mutations": {
      "addMemory": {
        "desc": "写入一条新记忆",
        "op": "append",
        "path": "memories",
        "fields": {
          "type": { "type": "enum", "values": ["约定", "偏好", "事件", "进展", "其他"], "required": true },
          "content": { "type": "string", "required": true },
          "importance": { "type": "enum", "values": ["high", "medium", "low"], "default": "medium" },
          "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
          "source": { "type": "string", "default": "" }
        },
        "auto": { "id": "uuid", "createdAt": "nowIso" }
      },
      "updateMemory": {
        "desc": "修正一条已有记忆的内容或属性",
        "op": "update",
        "path": "memories",
        "match": "id",
        "fields": {
          "content": { "type": "string" },
          "importance": { "type": "enum", "values": ["high", "medium", "low"] },
          "type": { "type": "enum", "values": ["约定", "偏好", "事件", "进展", "其他"] },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "removeMemory": {
        "desc": "删除一条记忆",
        "op": "remove",
        "path": "memories",
        "match": "id"
      }
    }
  },
  "memories": []
}
