{
  "$manifest": {
    "version": 1,
    "desc": "魔法事务清单：条目、类别标签、优先级、完成状态与描述",
    "queries": {
      "listTodos": {
        "desc": "按状态/优先级/类别筛选待办，可按字段排序并分页。注意：按优先级排序应逐个用 priority 参数取（high→medium→low），sort=priority 只是字典序",
        "path": "todos",
        "identity": "id",
        "params": {
          "status": {
            "type": "enum",
            "values": [
              "todo",
              "doing",
              "done"
            ]
          },
          "priority": {
            "type": "enum",
            "values": [
              "high",
              "medium",
              "low"
            ]
          },
          "tag": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 20
      },
      "getTodo": {
        "desc": "按 ID 获取单条待办",
        "path": "todos",
        "identity": "id",
        "defaultLimit": 1
      },
      "listOpenTodos": {
        "desc": "查看未完成的事务（未开始/进行中），可按 priority 逐个取；sort=priority 为字典序，不能代表优先级高低",
        "path": "todos",
        "identity": "id",
        "params": {
          "status": {
            "type": "enum",
            "values": [
              "todo",
              "doing"
            ]
          },
          "priority": {
            "type": "enum",
            "values": [
              "high",
              "medium",
              "low"
            ]
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 20
      }
    },
    "mutations": {
      "addTodo": {
        "desc": "新增一条待办事务；tag 可选，不传就不设类别（没有默认标签）",
        "op": "append",
        "path": "todos",
        "fields": {
          "title": {
            "type": "string",
            "required": true
          },
          "tag": {
            "type": "string"
          },
          "priority": {
            "type": "enum",
            "values": [
              "high",
              "medium",
              "low"
            ],
            "default": "medium"
          },
          "status": {
            "type": "enum",
            "values": [
              "todo",
              "doing",
              "done"
            ],
            "default": "todo"
          },
          "notes": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "updateTodo": {
        "desc": "修改待办的标题、类别、优先级、状态或描述",
        "op": "update",
        "path": "todos",
        "match": "id",
        "fields": {
          "title": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "priority": {
            "type": "enum",
            "values": [
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "type": "enum",
            "values": [
              "todo",
              "doing",
              "done"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "setTodoStatus": {
        "desc": "设置待办的完成状态（未开始/进行中/已完成）",
        "op": "update",
        "path": "todos",
        "match": "id",
        "fields": {
          "status": {
            "type": "enum",
            "values": [
              "todo",
              "doing",
              "done"
            ],
            "required": true
          }
        }
      },
      "setTodoPriority": {
        "desc": "设置待办的优先级",
        "op": "update",
        "path": "todos",
        "match": "id",
        "fields": {
          "priority": {
            "type": "enum",
            "values": [
              "high",
              "medium",
              "low"
            ],
            "required": true
          }
        }
      },
      "removeTodo": {
        "desc": "删除一条待办",
        "op": "remove",
        "path": "todos",
        "match": "id"
      }
    }
  },
