{
  "$manifest": {
    "version": 1,
    "desc": "收纳地图：家里每个位置（柜子/箱子/抽屉）装了什么，用来回答「这东西放哪儿了」",
    "queries": {
      "listPlaces": {
        "desc": "列出所有收纳位置，可按房间（room）筛选",
        "path": "places",
        "identity": "id",
        "params": {
          "room": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 50
      },
      "listItemsInPlace": {
        "desc": "看某个位置里装了哪些东西（placeId 必传）",
        "path": "items",
        "identity": "id",
        "params": {
          "placeId": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 100
      },
      "listItems": {
        "desc": "按标签或名称筛选物品（找东西时用）",
        "path": "items",
        "identity": "id",
        "params": {
          "tags": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "placeId": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 100
      },
      "getPlace": {
        "desc": "按 ID 取单个位置",
        "path": "places",
        "identity": "id",
        "defaultLimit": 1
      }
    },
    "mutations": {
      "addPlace": {
        "desc": "新建一个收纳位置（柜子、箱子、抽屉、某个角落都可）",
        "op": "append",
        "path": "places",
        "fields": {
          "name": {
            "type": "string",
            "required": true
          },
          "room": {
            "type": "string",
            "default": "未指定"
          },
          "note": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "updatePlace": {
        "desc": "改位置的名称、房间或备注",
        "op": "update",
        "path": "places",
        "match": "id",
        "fields": {
          "name": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "removePlace": {
        "desc": "删除位置；其下物品不会自动删除，调用方应先用 listItemsInPlace 把里面的东西清空或挪走",
        "op": "remove",
        "path": "places",
        "match": "id"
      },
      "addItem": {
        "desc": "往某个位置放一件东西（placeId 必传，qty 默认 1）",
        "op": "append",
        "path": "items",
        "fields": {
          "placeId": {
            "type": "string",
            "required": true
          },
          "name": {
            "type": "string",
            "required": true
          },
          "qty": {
            "type": "integer",
            "default": 1
          },
          "tags": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "updateItem": {
        "desc": "改物品的名称、数量、标签或备注（换位置请用 moveItem）",
        "op": "update",
        "path": "items",
        "match": "id",
        "fields": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer"
          },
          "tags": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "moveItem": {
        "desc": "把一件东西挪到另一个位置（收纳换地方后更新）",
        "op": "update",
        "path": "items",
        "match": "id",
        "fields": {
          "placeId": {
            "type": "string",
            "required": true
          }
        }
      },
      "removeItem": {
        "desc": "删掉一条物品记录",
        "op": "remove",
        "path": "items",
        "match": "id"
      }
    }
  },
