{
  "$manifest": {
    "version": 1,
    "desc": "观影/游戏/阅读 backlog：待看清单、在追进度、看完评分与弃坑记录。口味画像存在顶层 profile 键（read_data 用 key=\"profile\" 读，setProfile 写）；每日一条的书影剧游推荐存在顶层 recommendations 键（addRecommendation 写，latestRecommendation / listRecommendations 读）",
    "queries": {
      "listBacklog": {
        "desc": "按状态/类型筛选作品，可按字段排序分页。status 取 wish（待看）/doing（在追）/done（看完）/dropped（弃了）",
        "path": "items",
        "identity": "id",
        "params": {
          "status": {
            "type": "enum",
            "values": [
              "wish",
              "doing",
              "done",
              "dropped"
            ]
          },
          "kind": {
            "type": "enum",
            "values": [
              "movie",
              "series",
              "game",
              "book"
            ]
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 30
      },
      "listInProgress": {
        "desc": "只看在追的作品（含 progress 百分比与 notes 里的集数/进度说明）",
        "path": "items",
        "identity": "id",
        "params": {
          "status": {
            "type": "enum",
            "values": [
              "wish",
              "doing",
              "done",
              "dropped"
            ],
            "default": "doing"
          },
          "kind": {
            "type": "enum",
            "values": [
              "movie",
              "series",
              "game",
              "book"
            ]
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 30
      },
      "listRated": {
        "desc": "只看已评分的作品（rating 1-10，含看完与弃掉的 —— 弃坑同样反映口味），分析偏好时用这个",
        "path": "items",
        "identity": "id",
        "params": {
          "status": {
            "type": "enum",
            "values": [
              "done",
              "dropped"
            ]
          },
          "kind": {
            "type": "enum",
            "values": [
              "movie",
              "series",
              "game",
              "book"
            ]
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 50
      },
      "getItem": {
        "desc": "按 ID 获取单条作品",
        "path": "items",
        "identity": "id",
        "defaultLimit": 1
      },
      "listRecommendations": {
        "desc": "按日期倒序查看每日推荐日志（写新推荐前用它避免重复、回顾推荐过什么），可按 kind 过滤",
        "path": "recommendations",
        "identity": "id",
        "params": {
          "kind": {
            "type": "enum",
            "values": [
              "movie",
              "series",
              "game",
              "book"
            ]
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 30
      },
      "latestRecommendation": {
        "desc": "取最新的一条每日推荐（date 最新的），用于仪表盘的「今日推荐」",
        "path": "recommendations",
        "identity": "id",
        "params": {
          "date": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 1
      }
    },
    "mutations": {
      "addItem": {
        "desc": "加入一部作品（自己加的或推荐进来的）。推荐时把 source 写「小助手推荐」，reason 写一句为什么推荐给这个人",
        "op": "append",
        "path": "items",
        "fields": {
          "title": {
            "type": "string",
            "required": true
          },
          "kind": {
            "type": "enum",
            "values": [
              "movie",
              "series",
              "game",
              "book"
            ],
            "required": true
          },
          "status": {
            "type": "enum",
            "values": [
              "wish",
              "doing",
              "done",
              "dropped"
            ],
            "default": "wish"
          },
          "year": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          },
          "progress": {
            "type": "integer",
            "default": 0
          },
          "rating": {
            "type": "integer"
          },
          "notes": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "default": "手动"
          },
          "reason": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "setStatus": {
        "desc": "改状态：开始看（doing）/看完（done）/弃了（dropped）/退回待看（wish）。看完时可同时把 progress 传 100",
        "op": "update",
        "path": "items",
        "match": "id",
        "fields": {
          "status": {
            "type": "enum",
            "values": [
              "wish",
              "doing",
              "done",
              "dropped"
            ],
            "required": true
          },
          "progress": {
            "type": "integer"
          }
        }
      },
      "setProgress": {
        "desc": "更新在追作品的进度百分比（0-100 整数）",
        "op": "update",
        "path": "items",
        "match": "id",
        "fields": {
          "progress": {
            "type": "integer",
            "required": true
          }
        }
      },
      "setRating": {
        "desc": "打分（1-10 整数）；看完和弃掉的作品都值得打分",
        "op": "update",
        "path": "items",
        "match": "id",
        "fields": {
          "rating": {
            "type": "integer",
            "required": true
          }
        }
      },
      "updateItem": {
        "desc": "改作品信息：标题、类型、年份、题材、备注、来源、推荐理由",
        "op": "update",
        "path": "items",
        "match": "id",
        "fields": {
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "enum",
            "values": [
              "movie",
              "series",
              "game",
              "book"
            ]
          },
          "year": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "removeItem": {
        "desc": "从 backlog 删除一条",
        "op": "remove",
        "path": "items",
        "match": "id"
      },
      "setProfile": {
        "desc": "写入口味画像：summary 一句话概括偏好（要具体），likes 反复喜欢的元素，dislikes 倾向弃掉的东西",
        "op": "set",
        "path": "profile",
        "fields": {
          "summary": {
            "type": "string"
          },
          "likes": {
            "type": "string"
          },
          "dislikes": {
            "type": "string"
          }
        },
        "auto": {
          "updatedAt": "nowIso"
        }
      },
      "addRecommendation": {
        "desc": "记一条每日推荐。date 是这条推荐归属的那天（YYYY-MM-DD，用当天的本地日期）；kind 取 movie/series/game/book；reason 写一句为什么贴合口味画像或某条历史记录。约定每天只保留一条（换推荐时先 removeRecommendation 删旧的）",
        "op": "append",
        "path": "recommendations",
        "fields": {
          "date": {
            "type": "string",
            "required": true
          },
          "title": {
            "type": "string",
            "required": true
          },
          "kind": {
            "type": "enum",
            "values": [
              "movie",
              "series",
              "game",
              "book"
            ],
            "required": true
          },
          "year": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "default": "小助手"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "removeRecommendation": {
        "desc": "删掉一条每日推荐（写重复了、或要「换一条」时先删旧的）",
        "op": "remove",
        "path": "recommendations",
        "match": "id"
      }
    }
  },
  "profile": {
