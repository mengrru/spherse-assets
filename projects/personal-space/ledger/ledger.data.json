{
  "$manifest": {
    "version": 1,
    "desc": "日常账本：一笔一笔记账，按月份与分类汇总。金额一律用整数「分」存储（¥38.50 = 3850），避免浮点误差；month 必须是 date 的前 7 位（YYYY-MM），用于按整月查询",
    "queries": {
      "listByMonth": {
        "desc": "取某个月的流水（先传 month，如 2026-09），可按类型 kind（expense/income）、分类 category 或支付方式 account 过滤并排序分页。本能力没有 sum 入口，汇总请自行加总 amountCents",
        "path": "transactions",
        "identity": "id",
        "params": {
          "month": {
            "type": "string"
          },
          "kind": {
            "type": "enum",
            "values": [
              "expense",
              "income"
            ]
          },
          "category": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 30
      },
      "listByCategory": {
        "desc": "查某分类在某个的支出明细（month + category 都传），用于回答「这个月餐饮花了多少」",
        "path": "transactions",
        "identity": "id",
        "params": {
          "month": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "kind": {
            "type": "enum",
            "values": [
              "expense",
              "income"
            ]
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 50
      },
      "getTransaction": {
        "desc": "按 ID 取单笔",
        "path": "transactions",
        "identity": "id",
        "defaultLimit": 1
      }
    },
    "mutations": {
      "addTransaction": {
        "desc": "记一笔。amountCents 是整数分（¥38.50 传 3850）；kind 默认 expense（支出），income 为收入；date 用 YYYY-MM-DD、month 用 YYYY-MM 且必须是 date 的前 7 位",
        "op": "append",
        "path": "transactions",
        "fields": {
          "amountCents": {
            "type": "integer",
            "required": true
          },
          "date": {
            "type": "string",
            "required": true
          },
          "month": {
            "type": "string",
            "required": true
          },
          "kind": {
            "type": "enum",
            "values": [
              "expense",
              "income"
            ],
            "default": "expense"
          },
          "category": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "account": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "updateTransaction": {
        "desc": "改一笔的金额、日期、类型、分类、备注或支付方式；改 date 时必须同时改 month 保持一致",
        "op": "update",
        "path": "transactions",
        "match": "id",
        "fields": {
          "amountCents": {
            "type": "integer"
          },
          "date": {
            "type": "string"
          },
          "month": {
            "type": "string"
          },
          "kind": {
            "type": "enum",
            "values": [
              "expense",
              "income"
            ]
          },
          "category": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "account": {
            "type": "string"
          }
        }
      },
      "removeTransaction": {
        "desc": "删掉一笔",
        "op": "remove",
        "path": "transactions",
        "match": "id"
      }
    }
  },
