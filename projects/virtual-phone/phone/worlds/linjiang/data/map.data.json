{
  "$manifest": {
    "version": 1,
    "desc": "小手机 · 临江地图：地点与到访记录（「你现在在哪」存在 shared.data.json 的 where）",
    "queries": {
      "listPlaces": {
        "desc": "列出所有地点",
        "path": "places",
        "identity": "id",
        "defaultLimit": 50
      },
      "listVisits": {
        "desc": "读取到访记录，最新在前，可按地点过滤",
        "path": "visits",
        "identity": "id",
        "params": {
          "placeId": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 30
      }
    },
    "mutations": {
      "createPlace": {
        "desc": "在地图上新增一个地点（角色发现新地方时也能用）",
        "op": "append",
        "path": "places",
        "fields": {
          "name": {
            "type": "string",
            "required": true
          },
          "kind": {
            "type": "enum",
            "values": [
              "shop",
              "food",
              "home",
              "transit",
              "view",
              "public"
            ],
            "default": "shop"
          },
          "emoji": {
            "type": "string"
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "desc": {
            "type": "string"
          },
          "hours": {
            "type": "string"
          },
          "characterId": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "updatePlace": {
        "desc": "改一个地点的描述、营业时间等",
        "op": "update",
        "path": "places",
        "match": "id",
        "fields": {
          "desc": {
            "type": "string"
          },
          "hours": {
            "type": "string"
          },
          "characterId": {
            "type": "string"
          }
        }
      },
      "addVisit": {
        "desc": "记一次到访",
        "op": "append",
        "path": "visits",
        "fields": {
          "placeId": {
            "type": "string",
            "required": true
          },
          "note": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "removeVisit": {
        "desc": "删一条到访记录",
        "op": "remove",
        "path": "visits",
        "match": "id"
      }
    }
  },
  "places": [
    {
      "id": "place-bookstore",
      "name": "白鹿书店",
      "kind": "shop",
      "emoji": "📚",
      "x": 22,
      "y": 28,
      "desc": "老城区一条小巷里的旧书店。柜台底下真的会给人留书，规矩是「先来的人有」。",
      "hours": "10:00 – 19:00",
      "characterId": "char-suwan",
      "createdAt": "2025-01-01T00:00:00.000Z"
    },
    {
      "id": "place-wonton",
      "name": "巷口馄饨摊",
      "kind": "food",
      "emoji": "🥟",
      "x": 40,
      "y": 64,
      "desc": "只在深夜开，塑料棚，两张折叠桌。老板记性很好，记得每个熟客要不要葱。",
      "hours": "21:00 – 03:00",
      "characterId": "char-suwan",
