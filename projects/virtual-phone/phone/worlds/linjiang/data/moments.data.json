{
  "$manifest": {
    "version": 1,
    "desc": "小手机 · 朋友圈：动态与评论",
    "queries": {
      "listMoments": {
        "desc": "读取朋友圈动态，最新在前，可按作者过滤",
        "path": "moments",
        "identity": "id",
        "params": {
          "authorId": { "type": "string" },
          "sort": { "type": "field" },
          "dir": { "type": "enum", "values": ["asc", "desc"], "default": "desc" }
        },
        "defaultLimit": 20
      },
      "listMomentComments": {
        "desc": "读取某条动态下面的评论，按时间升序",
        "path": "momentComments",
        "identity": "id",
        "params": {
          "momentId": { "type": "string" },
          "sort": { "type": "field" },
          "dir": { "type": "enum", "values": ["asc", "desc"], "default": "asc" }
        },
        "defaultLimit": 50
      }
    },
    "mutations": {
      "createMoment": {
        "desc": "在朋友圈发一条动态",
        "op": "append",
        "path": "moments",
        "fields": {
          "authorId": { "type": "string", "required": true },
          "authorName": { "type": "string" },
          "text": { "type": "string", "required": true },
          "emoji": { "type": "string" },
          "place": { "type": "string" },
          "likeCount": { "type": "integer", "default": 0 },
          "likedByMe": { "type": "boolean", "default": false }
        },
        "auto": { "id": "uuid", "createdAt": "nowIso" }
      },
      "likeMoment": {
        "desc": "点赞或取消赞某条动态",
        "op": "update",
        "path": "moments",
        "match": "id",
        "fields": {
          "likedByMe": { "type": "boolean" },
          "likeCount": { "type": "integer" }
        }
      },
      "addMomentComment": {
        "desc": "在某条动态下发表评论",
        "op": "append",
        "path": "momentComments",
        "fields": {
          "momentId": { "type": "string", "required": true },
          "authorId": { "type": "string", "required": true },
          "authorName": { "type": "string" },
          "text": { "type": "string", "required": true }
        },
        "auto": { "id": "uuid", "createdAt": "nowIso" }
      },
      "removeMoment": {
        "desc": "删除一条动态",
        "op": "remove",
        "path": "moments",
        "match": "id"
      },
      "removeMomentComment": {
        "desc": "删除一条评论",
        "op": "remove",
        "path": "momentComments",
        "match": "id"
      }
    }
  },
  "moments": [
