{
  "$manifest": {
    "version": 1,
    "desc": "小手机 · 微信：聊天记录",
    "queries": {
      "listMessages": {
        "desc": "读取某个会话的聊天记录，默认按时间升序",
        "path": "messages",
        "identity": "id",
        "params": {
          "conversationId": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 50
      }
    },
    "mutations": {
      "appendMessage": {
        "desc": "向会话追加一条消息（role: user=手机主人, character=好友）",
        "op": "append",
        "path": "messages",
        "fields": {
          "conversationId": {
            "type": "string",
            "required": true
          },
          "role": {
            "type": "enum",
            "values": [
              "user",
              "character"
            ],
            "required": true
          },
          "text": {
            "type": "string",
            "required": true
          },
          "mood": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "removeMessage": {
        "desc": "删除一条消息",
        "op": "remove",
        "path": "messages",
        "match": "id"
      }
    }
  },
  "messages": [
    {
      "id": "seed-1",
      "conversationId": "conv-suwan",
      "role": "character",
      "text": "还没睡？",
      "mood": "失眠",
