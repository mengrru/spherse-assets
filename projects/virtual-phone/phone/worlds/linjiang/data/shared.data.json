{
  "$manifest": {
    "version": 1,
    "desc": "小手机 · 公共数据：手机主人、世界时钟、好友与会话（所有 App 共用）",
    "queries": {
      "listCharacters": {
        "desc": "列出手机里所有好友",
        "path": "characters",
        "identity": "id",
        "defaultLimit": 50
      },
      "getCharacter": {
        "desc": "按 id 获取单个好友（含好感度、心情、正在做什么）",
        "path": "characters",
        "identity": "id",
        "defaultLimit": 1
      },
      "listConversations": {
        "desc": "列出会话，可按好友过滤",
        "path": "conversations",
        "identity": "id",
        "params": {
          "characterId": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 50
      }
    },
    "mutations": {
      "createCharacter": {
        "desc": "往手机里新增一个好友",
        "op": "append",
        "path": "characters",
        "fields": {
          "name": {
            "type": "string",
            "required": true
          },
          "agentSlug": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "avatarEmoji": {
            "type": "string"
          },
          "avatarColor": {
            "type": "string"
          },
          "mood": {
            "type": "string"
          },
          "doing": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "updateCharacter": {
        "desc": "更新好友状态：好感度、心情、此刻在做什么",
        "op": "update",
        "path": "characters",
        "match": "id",
        "fields": {
          "affection": {
            "type": "integer"
          },
          "mood": {
            "type": "string"
          },
          "doing": {
            "type": "string"
          },
          "lastActiveAt": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "personaFile": {
            "type": "string"
          },
          "agentSlug": {
            "type": "string"
          },
          "placeName": {
            "type": "string"
          },
          "background": {
            "type": "string"
          }
        }
      },
      "createConversation": {
        "desc": "为某个好友新建一个会话",
        "op": "append",
        "path": "conversations",
        "fields": {
          "characterId": {
            "type": "string",
            "required": true
          },
          "title": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "setConversationSession": {
        "desc": "记录会话绑定的 agent 会话 id 与最近活跃时间",
        "op": "update",
        "path": "conversations",
        "match": "id",
        "fields": {
          "sessionId": {
            "type": "string"
          },
          "lastActiveAt": {
            "type": "string"
          }
        }
      },
      "setWorldClock": {
        "desc": "设置手机世界时钟：基准时刻与流速（页面用，好友只读）",
        "op": "set",
        "path": "worldClock",
        "fields": {
          "anchorReal": {
            "type": "string"
          },
          "anchorWorld": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "now": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "setTheme": {
        "desc": "切换整台手机的配色主题与设计语言",
        "op": "set",
        "path": "theme",
        "fields": {
          "id": {
            "type": "string"
          },
          "skin": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "setWallpaper": {
        "desc": "把手机壁纸换成相册里的某张照片：src 是**世界目录内**的相对路径（如 assets/xxx.jpg）。src 传空字符串 = 用回主题自带的壁纸",
        "op": "set",
        "path": "wallpaper",
        "fields": {
          "src": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      },
      "setWhere": {
        "desc": "记录手机主人现在在哪（地点 id 与名字，名字冗余存一份方便各处显示）",
        "op": "set",
        "path": "where",
        "fields": {
          "placeId": {
            "type": "string"
          },
          "placeName": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    }
  },
