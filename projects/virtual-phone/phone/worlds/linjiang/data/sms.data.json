{
  "$manifest": {
    "version": 1,
    "desc": "小手机 · 短信：会话与短信内容（另一条通道，区别于微信）",
    "queries": {
      "listSmsThreads": {
        "desc": "列出短信会话，最新在前，可按类型过滤（char=好友号码 system=机构号 unknown=陌生号码）",
        "path": "smsThreads",
        "identity": "id",
        "params": {
          "kind": {
            "type": "enum",
            "values": [
              "char",
              "system",
              "unknown"
            ]
          },
          "characterId": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 30
      },
      "listSms": {
        "desc": "读取某个会话的短信，默认按时间升序",
        "path": "sms",
        "identity": "id",
        "params": {
          "threadId": {
            "type": "string"
          },
          "role": {
            "type": "enum",
            "values": [
              "user",
              "character"
            ]
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 50
      }
    },
    "mutations": {
      "createSmsThread": {
        "desc": "新建一个短信会话",
        "op": "append",
        "path": "smsThreads",
        "fields": {
          "kind": {
            "type": "enum",
            "values": [
              "char",
              "system",
              "unknown"
            ],
            "required": true
          },
          "name": {
            "type": "string",
            "required": true
          },
          "number": {
            "type": "string"
          },
          "characterId": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "appendSms": {
        "desc": "往会话追加一条短信。role: user=手机主人发的, character=对方发的",
        "op": "append",
        "path": "sms",
        "fields": {
          "threadId": {
            "type": "string",
            "required": true
          },
          "role": {
            "type": "enum",
            "values": [
              "user",
              "character"
            ],
            "required": true
          },
          "text": {
            "type": "string",
            "required": true
          },
          "sender": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "setSmsAgentSession": {
        "desc": "记录短信局这个 Agent 的会话 id（所有短信共用同一个会话）",
        "op": "set",
        "path": "agent",
        "fields": {
          "sessionId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "removeSms": {
        "desc": "删除一条短信",
        "op": "remove",
        "path": "sms",
        "match": "id"
      }
    }
  },
  "agent": {
    "sessionId": null,
    "updatedAt": null
  },
  "smsThreads": [
    {
