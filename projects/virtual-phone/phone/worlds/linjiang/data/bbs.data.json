{
  "$manifest": {
    "version": 1,
    "desc": "小手机 · 临江论坛：版块、帖子与楼层回复（匿名树洞也在这里）",
    "queries": {
      "listPosts": {
        "desc": "读取帖子，最新在前，可按版块过滤（chat=杂谈 hole=树洞 lost=找人·失物 market=二手）",
        "path": "posts",
        "identity": "id",
        "params": {
          "board": {
            "type": "enum",
            "values": [
              "chat",
              "hole",
              "lost",
              "market"
            ]
          },
          "author": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "desc"
          }
        },
        "defaultLimit": 20
      },
      "listReplies": {
        "desc": "读取某个帖子的回复，按时间升序（就是楼层顺序）",
        "path": "replies",
        "identity": "id",
        "params": {
          "postId": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 50
      }
    },
    "mutations": {
      "createPost": {
        "desc": "发一条新帖。anonymous=true 时按匿名树洞处理，author 仍会记录昵称",
        "op": "append",
        "path": "posts",
        "fields": {
          "board": {
            "type": "enum",
            "values": [
              "chat",
              "hole",
              "lost",
              "market"
            ],
            "required": true
          },
          "title": {
            "type": "string",
            "required": true
          },
          "body": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "anonymous": {
            "type": "boolean",
            "default": false
          },
          "likeCount": {
            "type": "integer",
            "default": 0
          },
          "likedByMe": {
            "type": "boolean",
            "default": false
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "addReply": {
        "desc": "在帖子里回复一层（楼层按时间顺序自动排）",
        "op": "append",
        "path": "replies",
        "fields": {
          "postId": {
            "type": "string",
            "required": true
          },
          "author": {
            "type": "string",
            "required": true
          },
          "body": {
            "type": "string",
            "required": true
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "likePost": {
        "desc": "点赞或取消赞",
        "op": "update",
        "path": "posts",
        "match": "id",
        "fields": {
          "likeCount": {
            "type": "integer"
          },
          "likedByMe": {
            "type": "boolean"
          }
        }
      },
      "removePost": {
        "desc": "删帖",
        "op": "remove",
        "path": "posts",
        "match": "id"
      },
      "removeReply": {
        "desc": "删一层回复",
        "op": "remove",
        "path": "replies",
        "match": "id"
      },
      "setBbsAgentSession": {
        "desc": "记录论坛这个 Agent 的会话 id（所有版块共用一个会话）",
        "op": "set",
        "path": "agent",
        "fields": {
          "sessionId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    }
  },
  "agent": {
    "sessionId": null,
    "updatedAt": null
  },
  "posts": [
    {
      "id": "post-lost-earphone",
      "board": "lost",
      "title": "二号线捡到一个耳机盒，里面有张便利贴",
      "body": "昨天下午在二号线，座位底下捡到一个耳机盒，里面没有耳机，就一张便利贴写着个手机号。我按号码发了条短信问过了，等对方回复。要是你的，跟我说一声。",
      "author": "拾到东西的人",
      "anonymous": false,
      "likeCount": 4,
      "likedByMe": false,
      "createdAt": "2026-10-02T11:20:00.000Z"
    },
    {
      "id": "post-wonton",
      "board": "chat",
      "title": "巷口那家馄饨摊是不是要搬了？",
      "body": "上周去的时候老板说房东涨租，可能撑不到年底。有人知道具体情况吗？凌晨两点还开着的那家，别真搬了。",
