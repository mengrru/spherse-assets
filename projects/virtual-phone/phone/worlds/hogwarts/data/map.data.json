{
  "$manifest": {
    "version": 1,
    "desc": "霍格沃茨 · 城堡地图：地点与到访记录（「你现在在哪」存在 shared.data.json 的 where）",
    "queries": {
      "listPlaces": {
        "desc": "列出所有地点",
        "path": "places",
        "identity": "id",
        "defaultLimit": 50
      },
      "listVisits": {
        "desc": "读取到访记录，最新在前，可按地点过滤",
        "path": "visits",
        "identity": "id",
        "params": {
          "placeId": { "type": "string" },
          "sort": { "type": "field" },
          "dir": { "type": "enum", "values": ["asc", "desc"], "default": "desc" }
        },
        "defaultLimit": 30
      }
    },
    "mutations": {
      "createPlace": {
        "desc": "在地图上新增一个地点（角色发现新地方时也能用）",
        "op": "append",
        "path": "places",
        "fields": {
          "name": { "type": "string", "required": true },
          "kind": { "type": "enum", "values": ["shop", "food", "home", "transit", "view", "public"], "default": "public" },
          "emoji": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "desc": { "type": "string" },
          "hours": { "type": "string" },
          "characterId": { "type": "string" }
        },
        "auto": { "id": "uuid", "createdAt": "nowIso" }
      },
      "updatePlace": {
        "desc": "改一个地点的描述、时间等",
        "op": "update",
        "path": "places",
        "match": "id",
        "fields": {
          "desc": { "type": "string" },
          "hours": { "type": "string" },
          "characterId": { "type": "string" }
        }
      },
      "addVisit": {
        "desc": "记一次到访",
        "op": "append",
        "path": "visits",
        "fields": {
          "placeId": { "type": "string", "required": true },
          "note": { "type": "string" }
        },
        "auto": { "id": "uuid", "createdAt": "nowIso" }
      },
      "removeVisit": {
        "desc": "删一条到访记录",
        "op": "remove",
        "path": "visits",
        "match": "id"
      }
    }
  },
  "places": [
