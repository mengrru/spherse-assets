{
  "$manifest": {
    "version": 1,
    "desc": "霍格沃茨 · 双面镜：聊天记录",
    "queries": {
      "listMessages": {
        "desc": "读取某个会话的聊天记录，默认按时间升序",
        "path": "messages",
        "identity": "id",
        "params": {
          "conversationId": {
            "type": "string"
          },
          "sort": {
            "type": "field"
          },
          "dir": {
            "type": "enum",
            "values": [
              "asc",
              "desc"
            ],
            "default": "asc"
          }
        },
        "defaultLimit": 50
      }
    },
    "mutations": {
      "appendMessage": {
        "desc": "向会话追加一条消息（role: user=手机主人, character=好友）",
        "op": "append",
        "path": "messages",
        "fields": {
          "conversationId": {
            "type": "string",
            "required": true
          },
          "role": {
            "type": "enum",
            "values": [
              "user",
              "character"
            ],
            "required": true
          },
          "text": {
            "type": "string",
            "required": true
          },
          "mood": {
            "type": "string"
          }
        },
        "auto": {
          "id": "uuid",
          "createdAt": "nowIso"
        }
      },
      "removeMessage": {
        "desc": "删除一条消息",
        "op": "remove",
        "path": "messages",
        "match": "id"
      }
    }
  },
  "messages": [
    {
      "conversationId": "conv-luna",
      "role": "character",
      "text": "金妮说你也有这个。她还说你人还行 —— 她一般不会这么说。",
