{
  "$manifest": {
    "version": 1,
    "desc": "小手机 · 日历（这个世界里叫「课表」）：日子与约定。日期一律是「手机世界里的日期」（YYYY-MM-DD），不是现实日期",
    "queries": {
      "listEvents": {
        "desc": "读取日程（不带参数就是全部）。要按天看就传 date；who 可以填 \"me\" 或某个角色的档案 id",
        "path": "events",
        "identity": "id",
        "params": {
          "date": { "type": "string" },
          "who": { "type": "string" },
          "sort": { "type": "field" },
          "dir": { "type": "enum", "values": ["asc", "desc"], "default": "asc" }
        },
        "defaultLimit": 100
      },
      "listMarks": {
        "desc": "读取纪念日（「从那天起算」的事，比如认识、入学）。展示为「第 N 天」",
        "path": "marks",
        "identity": "id",
        "defaultLimit": 20
      }
    },
    "mutations": {
      "addEvent": {
        "desc": "记一件事（手机主人和角色都能加）。课、训练这类每周固定的填 repeat: \"weekly\"（日期填那周的任何一天）",
        "op": "append",
        "path": "events",
        "fields": {
          "date": { "type": "string", "required": true },
          "title": { "type": "string", "required": true },
          "time": { "type": "string" },
          "who": { "type": "string", "default": "me" },
          "kind": { "type": "enum", "values": ["plan", "work", "school", "date", "note", "anniversary"], "default": "plan" },
          "note": { "type": "string" },
          "repeat": { "type": "enum", "values": ["none", "weekly", "yearly"], "default": "none" },
          "done": { "type": "boolean", "default": false }
        },
        "auto": { "id": "uuid", "createdAt": "nowIso" }
      },
      "updateEvent": {
        "desc": "改一件事：时间、标题、备注，或者标记做完（done）",
        "op": "update",
        "path": "events",
        "match": "id",
        "fields": {
          "date": { "type": "string" },
          "time": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": "string" },
          "repeat": { "type": "enum", "values": ["none", "weekly", "yearly"] },
          "done": { "type": "boolean" }
        }
      },
      "removeEvent": {
        "desc": "删一件事",
        "op": "remove",
        "path": "events",
        "match": "id"
      },
      "addMark": {
        "desc": "加一个纪念日（从某天开始算，展示为「第 N 天」）",
        "op": "append",
        "path": "marks",
        "fields": {
          "title": { "type": "string", "required": true },
          "since": { "type": "string", "required": true },
          "emoji": { "type": "string" }
        },
        "auto": { "id": "uuid", "createdAt": "nowIso" }
      }
    }
  },
